# 本地开发用的环境变量示例
#
# 复制成 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略，不会提交）。
#   cp .env.example .env.local

# 验证服务（老站）地址：进群/报名前的清华邮箱验证由它完成。
# 不配置时默认指向 https://thu-swim.netlify.app，一般不用改。
# NEXT_PUBLIC_JOIN_API=https://thu-swim.netlify.app

# 以下只在构建 GitHub Pages 版本时需要（Actions 会自动注入）
# NEXT_PUBLIC_BASE_PATH=/thu-swim-static
# SITE_URL=https://llw24.github.io/thu-swim-static

